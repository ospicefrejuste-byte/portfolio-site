# Copier en .env sur l’hébergement seulement. Ne jamais publier .env.
SITE_DOMAIN=cours.example.com
PUBLIC_ORIGIN=https://cours.example.com
# Renseigner les trois clés KKiaPay depuis le tableau de bord du prestataire.
# Toute clé divulguée dans une conversation doit être remplacée avant usage.
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true
# CRS_SETUP_TOKEN est facultatif. Sans cette variable, un code est généré dans /data/setup-token.
